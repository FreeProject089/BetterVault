{
  "manifest_version": 3,
  "name": "BetterVault",
  "version": "1.0.0",
  "description": "Remplissage des identifiants et codes 2FA depuis votre coffre BetterVault chiffré.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "BetterVault",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@bettervault.app",
      "strict_min_version": "121.0"
    }
  }
}
