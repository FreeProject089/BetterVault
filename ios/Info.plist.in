<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fusionné par xtool avec ses valeurs par défaut ; @VERSION@ et @BUILD@ remplacés par scripts/build-ios.sh -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>BetterVault</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID déverrouille votre coffre sans retaper le mot de passe principal.</string>
	<key>NSCameraUsageDescription</key>
	<string>La caméra lit les QR codes de double authentification et les pièces d’identité.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Les photos choisies sont chiffrées et jointes à vos éléments.</string>
	<!-- Serveur auto-hébergé sur le réseau local (http://192.168.x.x) ; Internet reste en HTTPS -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Les exports apparaissent dans l'app Fichiers, dossier « BetterVault » -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
