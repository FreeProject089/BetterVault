# Copier en server/.env, puis remplacer le secret (32 caractères minimum).
# Génération : openssl rand -base64 48
#
# Démarrage habituel, dans deux terminaux :
#   npm run server     → API sur 127.0.0.1:8787
#   npm run dev        → application sur http://localhost:3000 (proxy /api, /admin, /legal)

BETTERVAULT_SECRET=remplacer-par-une-longue-valeur-aleatoire-unique
PORT=8787
HOST=127.0.0.1
BETTERVAULT_DB=server/data/bettervault.db
TRUST_PROXY=false
# Origines autorisées séparées par des virgules (vide = toutes)
CORS_ORIGINS=

# Adresse de l'application telle qu'elle apparaît dans les emails.
# En développement c'est le serveur Vite, pas le port de l'API.
PUBLIC_URL=http://localhost:3000
REGISTRATION_OPEN=true

# Jeton de la page /admin, 16 caractères minimum.
# Vide : un jeton est généré au premier démarrage et affiché dans la console.
ADMIN_TOKEN=

# ── Emails ─────────────────────────────────────────────────────────────────
# Vide : le serveur annonce qu'il n'envoie pas d'emails, et la clé de secours
# suffit à réinitialiser un mot de passe.
#
# Pour les essayer sans serveur SMTP, lancez un collecteur local :
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# puis SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_SECURITY=none.
# Les messages s'affichent sur http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BetterVault <no-reply@exemple.fr>
SMTP_ALLOW_INVALID_CERT=false

# ── Photo de profil ────────────────────────────────────────────────────────
AVATAR_UPLOADS=true
AVATAR_URLS=true
LIMIT_MAX_AVATAR_KB=512

# ── Lieu approximatif des sessions ─────────────────────────────────────────
# Base à télécharger une fois : node scripts/download-geoip.mjs
# (vide = geoip.mmdb à côté de la base de données)
GEOIP_DB=
# false en développement : true déclenche un téléchargement mensuel de 120 Mo.
GEOIP_AUTO_UPDATE=false

# ── Documents légaux (/legal) ──────────────────────────────────────────────
# Sans ces valeurs les pages s'affichent avec des trous. Modifiables dans /admin.
# Publier ou non les documents légaux de ce serveur.
# false : /legal répond 404 et l'application ne demande plus d'accepter de conditions.
# À réserver à un serveur personnel — dès que d'autres personnes y ont un compte,
# les informer relève de l'hébergeur, c'est-à-dire de vous.
LEGAL_ENABLED=true
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_CONTACT=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATION=
# AAAA-MM-JJ
LEGAL_EFFECTIVE_DATE=

# ── Limites ────────────────────────────────────────────────────────────────
# Liste complète dans le .env.example de la racine. Pour vérifier les messages
# de limite sans fabriquer des milliers d'éléments, abaissez-en une le temps
# d'un essai, par exemple LIMIT_MAX_CREDENTIALS_PER_VAULT=3.
LIMIT_MAX_CREDENTIALS_PER_VAULT=5000
LIMIT_MAX_NOTE_LENGTH=20000
LIMIT_MAX_URL_LENGTH=2048
LIMIT_MAX_VAULT_MB=20
