# Modèle du fichier .env d'une instance sur le VPS.
# Copier en <DEPLOY_PATH>/production/.env et <DEPLOY_PATH>/staging/.env, puis remplir.
# Ce fichier contient des secrets : droits 600, jamais dans Git.
#
# Chaque environnement a ses propres valeurs : le staging ne partage ni secret,
# ni jeton d'administration, ni base avec la production.

# 48 octets aléatoires : openssl rand -base64 48
BETTERVAULT_SECRET=
# Jeton de /admin, 16 caractères minimum : openssl rand -hex 24
ADMIN_TOKEN=
# Adresse publique : https://vault.exemple.fr (production) ou https://dev.vault.exemple.fr (staging)
PUBLIC_URL=
REGISTRATION_OPEN=true
GEOIP_AUTO_UPDATE=true

# Emails (facultatif) — voir docs/deployment/configuration.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
