# Copier en .env à la racine (utilisé par docker compose), ou lancer scripts/install.sh / scripts/install.ps1

# ── Serveur ────────────────────────────────────────────────────────────────
# Secret du serveur, 32 caractères minimum. Exemple de génération :
#   openssl rand -base64 48
BETTERVAULT_SECRET=

# Port local du conteneur (sans le profil https)
BETTERVAULT_PORT=8787

# Profil https : nom de domaine pointant vers la machine
DOMAIN=vault.exemple.fr

# Adresse publique de l'application, affichée dans les emails
PUBLIC_URL=https://vault.exemple.fr

# Mettre true derrière un reverse proxy (profil https, Nginx, Traefik…)
TRUST_PROXY=false

# Origines autorisées à appeler l'API, séparées par des virgules (vide = toutes)
CORS_ORIGINS=

# Autoriser la création de nouveaux comptes
REGISTRATION_OPEN=true

# Jeton de la page /admin (16 caractères minimum).
# Vide : un jeton est généré au premier démarrage et affiché dans les journaux. « disabled » : page désactivée.
ADMIN_TOKEN=

# ── Emails (SMTP) ──────────────────────────────────────────────────────────
# Codes de réinitialisation du mot de passe et alertes de sécurité. Laisser SMTP_HOST vide pour désactiver.
SMTP_HOST=
# 587 avec starttls, 465 avec tls
SMTP_PORT=587
# starttls, tls ou none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BetterVault <no-reply@exemple.fr>
# true uniquement pour un serveur SMTP interne au certificat auto-signé
SMTP_ALLOW_INVALID_CERT=false
#
# Pour essayer les emails sans serveur SMTP, un collecteur local est fourni :
#   docker compose --profile mail up -d
# puis SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none.
# Les messages s'affichent sur http://127.0.0.1:8025 et ne quittent jamais la machine.

# ── Limites ────────────────────────────────────────────────────────────────
# Appliquées par les applications avant le chiffrement ; le serveur vérifie la taille du coffre.
# Modifiables ensuite depuis /admin (les valeurs enregistrées là-bas remplacent celles-ci).
LIMIT_MAX_VAULTS=20
LIMIT_MAX_CREDENTIALS_PER_VAULT=5000
LIMIT_MAX_TASKS_PER_VAULT=5000
LIMIT_MAX_TITLE_LENGTH=200
LIMIT_MAX_USERNAME_LENGTH=500
LIMIT_MAX_PASSWORD_LENGTH=1000
LIMIT_MAX_URL_LENGTH=2048
LIMIT_MAX_NOTE_LENGTH=20000
LIMIT_MAX_CUSTOM_FIELDS=50
LIMIT_MAX_TAGS_PER_ITEM=20
# Taille maximale d'un coffre chiffré, en Mo
LIMIT_MAX_VAULT_MB=20
# Pièces jointes chiffrées : taille d'un fichier et espace par compte, en Mo
LIMIT_MAX_ATTACHMENT_MB=25
LIMIT_ATTACHMENT_QUOTA_MB=500
# Types de coffres personnalisés, membres et rôles par coffre partagé
LIMIT_MAX_VAULT_TYPES=20
LIMIT_MAX_MEMBERS_PER_SHARED_VAULT=50
LIMIT_MAX_ROLES_PER_SHARED_VAULT=30

# ── Sessions ───────────────────────────────────────────────────────────────
# Lieu approximatif des sessions, calculé sur le serveur (aucune adresse d'utilisateur transmise).
# Télécharger la base : node scripts/download-geoip.mjs   (vide = data/geoip.mmdb à côté de la base)
GEOIP_DB=
# true : le serveur télécharge la base DB-IP City Lite (60 Mo) puis la renouvelle chaque mois.
# Seul le serveur contacte db-ip.com ; aucune adresse d'utilisateur n'est envoyée.
GEOIP_AUTO_UPDATE=true

# ── Photo de profil ────────────────────────────────────────────────────────
AVATAR_UPLOADS=true
AVATAR_URLS=true
LIMIT_MAX_AVATAR_KB=512

# ── Espace supplémentaire payant (Stripe, facultatif) ─────────────────────
# Offres (prix Stripe et espace ajouté) à définir dans /admin.
# Webhook Stripe : https://votre-domaine/api/v1/billing/webhook
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Offres de départ, en JSON sur une ligne. Elles s'affichent telles quelles dans /admin,
# où elles peuvent ensuite être modifiées : ce qui est enregistré là-bas remplace ceci.
# Un JSON invalide arrête le serveur au démarrage plutôt que de le laisser sans offres.
#
#   id        identifiant court de l'offre
#   prices    une entrée par durée proposée ; le compte choisit au moment de payer
#             mode « payment » pour un achat unique, qui ne se renouvelle jamais
#   boosts    ce que l'offre ajoute aux limites du serveur, en octets ou en nombre :
#             attachmentQuotaBytes, maxAttachmentBytes, maxVaultBytes, maxVaults,
#             maxCredentialsPerVault
#
#BILLING_PLANS=[{"id":"plus","name":"Espace +","description":"Pour les pièces jointes volumineuses","prices":[{"id":"mensuel","label":"2 € / mois","stripePriceId":"price_1AbC…"},{"id":"annuel","label":"20 € / an","stripePriceId":"price_1DeF…"}],"boosts":{"attachmentQuotaBytes":5368709120,"maxVaults":5}}]
BILLING_PLANS=

# ── Documents légaux (/legal) ──────────────────────────────────────────────
# Modifiables dans /admin. L'hébergeur reste responsable de leur contenu.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_CONTACT=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATION=
# AAAA-MM-JJ
LEGAL_EFFECTIVE_DATE=

# ── Sauvegardes (S3) ───────────────────────────────────────────────────────
# MinIO fourni : docker compose --profile backup up -d  (BACKUP_S3_ENDPOINT=http://minio:9000)
# S3 externe : renseignez son adresse, sa région et ses clés, sans lancer le profil backup.
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
# Durée de conservation : les copies plus anciennes sont supprimées (données de comptes effacés comprises)
BACKUP_RETENTION_DAYS=30
# Phrase de chiffrement des copies de la base (à conserver hors du serveur : sans elle, pas de restauration)
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=bettervault-backups
BACKUP_S3_ACCESS_KEY=bettervault
# 8 caractères minimum avec MinIO
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=
# true pour MinIO et Garage, false pour AWS
BACKUP_S3_PATH_STYLE=true
