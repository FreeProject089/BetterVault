# Copier en .env à la racine (utilisé par docker compose), ou lancer scripts/install.sh / scripts/install.ps1

# ── Serveur ────────────────────────────────────────────────────────────────
# Secret du serveur, 32 caractères minimum. Exemple de génération :
#   openssl rand -base64 48
BETTERVAULT_SECRET=

# Port local du conteneur (sans le profil https)
BETTERVAULT_PORT=8787

# Profil https : nom de domaine pointant vers la machine
DOMAIN=vault.exemple.fr

# Adresse publique de l'application, affichée dans les emails
PUBLIC_URL=https://vault.exemple.fr

# Mettre true derrière un reverse proxy (profil https, Nginx, Traefik…)
TRUST_PROXY=false

# Origines autorisées à appeler l'API, séparées par des virgules (vide = toutes)
CORS_ORIGINS=

# Autoriser la création de nouveaux comptes
REGISTRATION_OPEN=true

# Jeton de la page /admin (16 caractères minimum).
# Vide : un jeton est généré au premier démarrage et affiché dans les journaux. « disabled » : page désactivée.
ADMIN_TOKEN=

# ── Emails (SMTP) ──────────────────────────────────────────────────────────
# Codes de réinitialisation du mot de passe et alertes de sécurité. Laisser SMTP_HOST vide pour désactiver.
SMTP_HOST=
# 587 avec starttls, 465 avec tls
SMTP_PORT=587
# starttls, tls ou none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BetterVault <no-reply@exemple.fr>
# true uniquement pour un serveur SMTP interne au certificat auto-signé
SMTP_ALLOW_INVALID_CERT=false

# ── Limites ────────────────────────────────────────────────────────────────
# Appliquées par les applications avant le chiffrement ; le serveur vérifie la taille du coffre.
# Modifiables ensuite depuis /admin (les valeurs enregistrées là-bas remplacent celles-ci).
LIMIT_MAX_VAULTS=20
LIMIT_MAX_CREDENTIALS_PER_VAULT=5000
LIMIT_MAX_TASKS_PER_VAULT=5000
LIMIT_MAX_TITLE_LENGTH=200
LIMIT_MAX_USERNAME_LENGTH=500
LIMIT_MAX_PASSWORD_LENGTH=1000
LIMIT_MAX_URL_LENGTH=2048
LIMIT_MAX_NOTE_LENGTH=20000
LIMIT_MAX_CUSTOM_FIELDS=50
LIMIT_MAX_TAGS_PER_ITEM=20
# Taille maximale d'un coffre chiffré, en Mo
LIMIT_MAX_VAULT_MB=20
